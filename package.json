{
  "name": "@fileverse/crypto",
  "version": "0.0.24",
  "description": "Crypto functions and helpers",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ecies": {
      "types": "./dist/ecies/index.d.ts",
      "import": "./dist/ecies/index.js",
      "require": "./dist/ecies/index.cjs"
    },
    "./webcrypto": {
      "types": "./dist/webcrypto/index.d.ts",
      "import": "./dist/webcrypto/index.js",
      "require": "./dist/webcrypto/index.cjs"
    },
    "./hkdf": {
      "types": "./dist/kdf/index.d.ts",
      "import": "./dist/kdf/index.js",
      "require": "./dist/kdf/index.cjs"
    },
    "./kdf": {
      "types": "./dist/kdf/index.d.ts",
      "import": "./dist/kdf/index.js",
      "require": "./dist/kdf/index.cjs"
    },
    "./argon": {
      "types": "./dist/argon/index.d.ts",
      "import": "./dist/argon/index.js",
      "require": "./dist/argon/index.cjs"
    },
    "./nacl": {
      "types": "./dist/nacl/index.d.ts",
      "import": "./dist/nacl/index.js",
      "require": "./dist/nacl/index.cjs"
    },
    "./pq": {
      "types": "./dist/pq/index.d.ts",
      "import": "./dist/pq/index.js",
      "require": "./dist/pq/index.cjs"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js",
      "require": "./dist/identity/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "require": "./dist/constants.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "vite",
    "build": "npm run clean && vite build",
    "build:prod": "npm run clean && NODE_ENV=production vite build && find dist -name \"*.map\" -delete",
    "prepare": "npm run build:prod",
    "preview": "vite preview",
    "test": "vitest",
    "capture:vectors": "node scripts/capture-vectors.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "AGPL-3.0-only",
  "sideEffects": false,
  "keywords": [
    "cryptography",
    "encryption",
    "webcrypto",
    "rsa",
    "aes",
    "ecies"
  ],
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitest/ui": "^3.1.2",
    "futoin-hkdf": "^1.5.3",
    "terser": "^5.28.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "@hpke/common": "1.10.1",
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0",
    "@hpke/hybridkem-x-wing": "0.7.0",
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "js-base64": "^3.7.7",
    "mlkem": "2.7.0",
    "tweetnacl": "^1.0.3"
  },
  "overrides": {
    "@hpke/core": "1.9.0",
    "@hpke/hybridkem-x-wing": "0.7.0",
    "@hpke/common": "1.10.1",
    "@hpke/dhkem-x25519": "1.8.0",
    "mlkem": "2.7.0"
  }
